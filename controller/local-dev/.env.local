# Fixed, dev-only values for the local stack (docker-compose.local.yml).
# Used both for compose variable interpolation (--env-file) and as the controller's env_file.
# Never reuse any of these outside local development.

CONTROLLER_ENV_FILE=local-dev/.env.local

# ---- Controller ----
PORT=8875
SESSION_SECRET=local-dev-session-secret
AUTHENTIK_CLIENT_ID=home-automation-controller-dev
AUTHENTIK_CLIENT_SECRET=local-dev-client-secret-0123456789abcdef
AUTHENTIK_ISSUER_URL=http://auth.localhost:9000/application/o/home-automation-controller/
AUTHENTIK_REDIRECT_URI=http://localhost:8875/auth/callback
PAPERLESS_URL=http://paperless:8000
PAPERLESS_TOKEN=0000000000000000000000000000000000000dev
# Controller folders on the host, kept together under local-dev/mnt (git-ignored).
# Paperless consumes from the same folder as DIR_PAPERLESS_CONSUME, so scans flow end-to-end.
DIR_PRINTER_PAPERLESS=./local-dev/mnt/scans
DIR_PAPERLESS_CONSUME=./local-dev/mnt/paperless-consume
DIR_PAPERLESS_EXPORT=./local-dev/mnt/paperless-exports
DIR_SYNOLOGY_DOCS=./local-dev/mnt/nas
DIR_CONFIG=./local-dev/mnt/config
DIR_POWER_MONITORING_INBOX=./local-dev/mnt/power-monitoring/inbox
DIR_POWER_MONITORING_PROCESSED=./local-dev/mnt/power-monitoring/processed
DIR_POWER_MONITORING_METADATA=./local-dev/mnt/power-monitoring/metadata
# HASS integration disabled locally
HASS_URL=
HASS_TOKEN=
HASS_TIMEZONE=Europe/Dublin

# ---- Authentik ----
AUTHENTIK_SECRET_KEY=local-dev-authentik-secret-key-0123456789abcdef0123456789
AUTHENTIK_DB_PASSWORD=authentik
AUTHENTIK_BOOTSTRAP_EMAIL=admin@local.test
AUTHENTIK_BOOTSTRAP_PASSWORD=admin
AUTHENTIK_BOOTSTRAP_TOKEN=local-dev-authentik-api-token
DEV_USER_PASSWORD=dev

# ---- Paperless ----
PAPERLESS_SECRET_KEY=local-dev-paperless-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=admin
