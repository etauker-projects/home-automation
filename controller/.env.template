PORT=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER_URL=
AUTHENTIK_REDIRECT_URI=
SESSION_SECRET=
PAPERLESS_TOKEN=
# Optional, defaults to https://paperless.office.etauker.com
PAPERLESS_URL=

# Host directories mounted into the container (see docker-compose.yml).
# Any left empty fall back to ./data/... next to the compose file.

# Paperless directories
DIR_PRINTER_PAPERLESS=
DIR_PAPERLESS_CONSUME=
DIR_PAPERLESS_EXPORT=
DIR_SYNOLOGY_DOCS=
DIR_CONFIG=

# Power monitoring directories
DIR_POWER_MONITORING_INBOX=
DIR_POWER_MONITORING_PROCESSED=
DIR_POWER_MONITORING_METADATA=

# Home Assistant REST API (set HASS_URL + HASS_TOKEN to enable HASS sync)
# HASS_URL: base URL of your HA instance.
#   - If HASS runs in Docker host-network mode: http://host.docker.internal:8123
#   - If HASS runs on a different machine: http://<ip>:8123
# HASS_TOKEN: Long-Lived Access Token (Profile → Security → Long-Lived Access Tokens)
# Leave both empty to disable HASS API integration
HASS_URL=http://host.docker.internal:8123
HASS_TOKEN=
HASS_TIMEZONE=Europe/Dublin
