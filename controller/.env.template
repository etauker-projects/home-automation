# User/group the container runs as (numeric). Set by ./setup-permissions.sh [1000]
UID=
GID=
PORT=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER_URL=
AUTHENTIK_REDIRECT_URI=
SESSION_SECRET=
PAPERLESS_TOKEN=
# Optional, defaults to https://paperless.office.etauker.com
PAPERLESS_URL=

# Host directories mounted into the container (see docker-compose.yml).
# Any left empty fall back to ./data/... next to the compose file.

# Paperless directories
DIR_PRINTER_PAPERLESS=
DIR_PAPERLESS_CONSUME=
DIR_PAPERLESS_EXPORT=
DIR_SYNOLOGY_DOCS=
DIR_CONFIG=

# Root of the document pipeline directories *inside the container* (optional) [/app/data]
# scans/, paperless-consume/, paperless-exports/, nas/ and config/ live under it.
# Only change this when running outside docker, e.g. pointing at a temp directory.
PIPELINE_DATA_ROOT=

# Document pipeline waiting periods (optional; defaults in brackets)
# Seconds a scanned file must stay unchanged before it is moved to paperless [180]
SCAN_STABILITY_SECONDS=
# Seconds an exported file must stay unchanged before it is backed up to the NAS [180]
EXPORT_STABILITY_SECONDS=
# Cron schedule and timezone of the paperless export ["15 * * * *", Europe/Dublin]
PAPERLESS_EXPORT_CRON=
PAPERLESS_EXPORT_TIMEZONE=
# Seconds between polls of paperless consume tasks, i.e. ingestion detection [60, min 5]
PAPERLESS_INGESTION_POLL_SECONDS=
# Seconds the paperless inbox count is cached [60, 0 = no cache]
PAPERLESS_INBOX_CACHE_SECONDS=
# Seconds between refreshes of the /ui/pipeline page [5]
PIPELINE_UI_REFRESH_SECONDS=

# Power monitoring directories
DIR_POWER_MONITORING_INBOX=
DIR_POWER_MONITORING_PROCESSED=
DIR_POWER_MONITORING_METADATA=

# Home Assistant REST API (set HASS_URL + HASS_TOKEN to enable HASS sync)
# HASS_URL: base URL of your HA instance.
#   - If HASS runs in Docker host-network mode: http://host.docker.internal:8123
#   - If HASS runs on a different machine: http://<ip>:8123
# HASS_TOKEN: Long-Lived Access Token (Profile → Security → Long-Lived Access Tokens)
# Leave both empty to disable HASS API integration
HASS_URL=http://host.docker.internal:8123
HASS_TOKEN=
HASS_TIMEZONE=Europe/Dublin
